{
  "name": "Austrian DSMR MQTT",
  "slug": "austrian_dsmr_mqtt",
  "version": "1.3.0",
  "build_date": "2026-10-23T00:00:00Z",
  "description": "Liest DSMR Smart Metern von Engerie Steiermark über seriell ein und publiziert via MQTT.",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "host_network": false,
  "uart": true,
  "map": [
    "data:rw"
  ],
  "options": {
    "GUEK": "myGUEK",
    "GAK": "myGAK",
    "MQTT_BROKER": "core-mosquitto",
    "MQTT_USER": "mqtt",
    "MQTT_PASSWORD": "myPassword",
    "SERIAL_INPUT_PORT": null,
    "DISCOVERY": true,
    "DISCOVERY_PREFIX": "homeassistant",
    "LEISTUNG_15MIN": true,
    "MAX_LEISTUNG_KW": 17.3
  },
  "schema": {
    "GUEK": "str",
    "GAK": "str",
    "MQTT_BROKER": "str",
    "MQTT_USER": "str",
    "MQTT_PASSWORD": "str",
    "SERIAL_INPUT_PORT": "device(subsystem=tty)",
    "DISCOVERY": "bool",
    "DISCOVERY_PREFIX": "str?",
    "LEISTUNG_15MIN": "bool",
    "MAX_LEISTUNG_KW": "float(0.1,100)"
  }
}
